# WordSnap server settings.
# In Docker/Unraid these can also be set through the web Settings dialog,
# which persists them under DATA_DIR.

DATA_DIR=/app/data

# Audio transcription uses OpenAI. Supported values: whisper-1, gpt-transcribe.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Enrichment can prefer either provider; the other is used as fallback.
# Allowed values: anthropic, openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
GPT_MODEL=gpt-5.5

# AnkiConnect inside the compose network.
ANKI_CONNECT_URL=http://anki:8765
ANKI_DECK=Swedish::WordSnap

# Auto-save new processed cards to Anki.
AUTO_ANKI=1
